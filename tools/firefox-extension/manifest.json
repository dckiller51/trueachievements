{
  "manifest_version": 2,
  "name": "TrueAchievements Sync",
  "version": "0.1.5",
  "description": "Downloads your TrueAchievements game collection CSV with your signed-in browser and sends it to Home Assistant.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ta-sync-private@dckiller51.github.io",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "https://www.trueachievements.com/*",
    "http://*/api/webhook/*",
    "https://*/api/webhook/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "TrueAchievements Sync"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
